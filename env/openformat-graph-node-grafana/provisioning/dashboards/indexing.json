          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "-- grafana ignore\nselect\n  g.name || (case\n        when g.pending_version = v.id then ' (P)'\n        when g.current_version = v.id then ' (C)'\n        else ' (U)' end) as subgraph_name,\n  d.deployment as deployment,\n  s.name as schema,\n  d.synced_at::text,\n  n.name as network,\n  (n.head_block_number - d.latest_ethereum_block_number) as blocks_behind_network,\n  (((n.head_block_number - d.latest_ethereum_block_number)/4)::text) as lag\nfrom subgraphs.subgraph_deployment as d,\n     subgraphs.subgraph_version as v,\n     subgraphs.subgraph as g,\n     ethereum_networks  as n,\n     deployment_schemas as s\nwhere g.id = v.subgraph\n  and v.id in (g.pending_version, g.current_version)\n  and s.subgraph = d.deployment\n  and v.deployment = d.deployment\n  and n.name = s.network\n  and not d.failed\norder by blocks_behind_network desc, subgraph_name;",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
